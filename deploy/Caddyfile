{$SITE_ADDRESS}

encode zstd gzip

handle /api/* {
	reverse_proxy backend:8001
}

# Hashed bundles never change: cache them for good. A missing one is a 404 (never index.html), so a stale page fails loudly.
handle /static/* {
	root * /srv
	header Cache-Control "public, max-age=31536000, immutable"
	file_server
}

# The page itself must be revalidated on every visit: after an update the browser gets the HTML that points to the new bundles.
handle {
	root * /srv
	header Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
